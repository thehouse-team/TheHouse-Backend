{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Foundation": {
    "MaxRequestBodyBytes": 65536,
    "RequestTimeoutSeconds": 15,
    "HealthTimeoutSeconds": 2,
    "CompressionMinimumBytes": 1024,
    "RateLimitPermitLimit": 60,
    "RateLimitWindowSeconds": 60
  },
  "Proxy": {
    "Enabled": false,
    "TrustAzureContainerAppsIngress": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "MongoDB": { "Enabled": false },
  "Redis": { "Enabled": false },
  "UniversitySeed": { "Enabled": false },
  "PropertySeed": { "Enabled": false },
  "Jwt": {
    "Enabled": false,
    "Issuer": "thehouse-api",
    "Audience": "thehouse-clients",
    "ExpirationSeconds": 900,
    "ClockSkewSeconds": 30
  },
  "LoginRateLimit": {
    "LoginEmailPerWindow": 5,
    "LoginIpPerWindow": 20,
    "WindowSeconds": 60
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "thehouse-backend",
    "ServiceVersion": "u2",
    "TraceSampleRatio": 0.10,
    "OtlpEnabled": false,
    "OtlpEndpoint": null
  },
  "PasswordHashing": { "Iterations": 210000 }
}
